{
  "name": "pharmacart-optimizer",
  "version": "0.0.0",
  "private": true,
  "description": "Ottimizzatore di carrello per comparare farmacie online",
  "workspaces": [
    "shared",
    "backend",
    "data-pipeline",
    "mobile"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
  "test": "npm run test --workspaces --if-present",
  "typecheck": "npm run typecheck --workspaces --if-present",
  "format": "prettier --write .",
  "format:check": "prettier --check .",
  "lint": "eslint .",
  "lint:fix": "eslint . --fix",
  "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
  
}
